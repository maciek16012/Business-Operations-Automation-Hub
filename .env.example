# Application
APP_ENV=development
APP_NAME=Business Operations Automation Hub
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=boah
POSTGRES_USER=boah
POSTGRES_PASSWORD=boah_dev_password
DATABASE_URL=postgresql+asyncpg://boah:boah_dev_password@postgres:5432/boah

# Local filesystem object storage
STORAGE_BACKEND=filesystem
STORAGE_PATH=/data/documents
MAX_UPLOAD_BYTES=5242880

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# n8n (local UI: http://localhost:5678)
N8N_TIMEZONE=Europe/Warsaw
# n8n generates its encryption key inside n8n_data; back up that volume.
# Enter mailbox credentials in n8n's IMAP credential UI, never in workflow JSON.
