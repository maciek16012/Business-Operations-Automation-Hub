# Application
APP_ENV=development
APP_NAME=Business Operations Automation Hub
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=boah
POSTGRES_USER=boah
POSTGRES_PASSWORD=boah_dev_password
DATABASE_URL=postgresql+asyncpg://boah:boah_dev_password@postgres:5432/boah

# Local filesystem object storage
STORAGE_BACKEND=filesystem
STORAGE_PATH=/data/documents
MAX_UPLOAD_BYTES=5242880

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# n8n (local UI: http://localhost:5678)
N8N_TIMEZONE=Europe/Warsaw
# n8n generates its encryption key inside n8n_data; back up that volume.
# Enter mailbox credentials in n8n's IMAP credential UI, never in workflow JSON.

# Milestone 4 — Straight-Through Processing
STP_ENABLED=false
STP_PRIMARY_OCR_PROVIDER=paddle
STP_NATIVE_MIN_CHARS_PER_PAGE=100
STP_NATIVE_MIN_ALNUM_RATIO=0.30
STP_NATIVE_MIN_PRINTABLE_RATIO=0.95
STP_NATIVE_MIN_TEXT_PAGE_RATIO=0.80
STP_NATIVE_MAX_IMAGE_AREA_RATIO=0.80
STP_TARGET_RATE=0.90
STP_REQUIRE_ZERO_CRITICAL_FALSE_ACCEPTS=true

# M5 secure intake: disabled only for trusted legacy regression fixtures.
SECURITY_PREFLIGHT_ENABLED=true
SECURITY_FAIL_CLOSED=true
SECURITY_MAX_ATTACHMENT_BYTES=5242880
SECURITY_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff,text/plain
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
REVIEW_NOTIFICATIONS_ENABLED=true
REVIEW_NOTIFICATION_WEBHOOK_URL=http://n8n:5678/webhook/boah-review-m5
REVIEW_NOTIFICATION_TIMEOUT_SECONDS=15

# M6 classification and typed extraction, after a persisted SAFE scan.
ADAPTIVE_EXTRACTION_ENABLED=true

# M7 local identities: first admin via interactive bootstrap or protected environment.
AUTH_ENABLED=true
AUTH_COOKIE_SECURE=false
BOAH_INITIAL_ADMIN_EMAIL=
BOAH_INITIAL_ADMIN_PASSWORD=
# Random base64-encoded 32-byte key, required to save connector secrets.
BOAH_MASTER_KEY=
# Scoped backend credential for n8n; generate locally, never embed in workflow JSON.
BOAH_SERVICE_TOKEN=
# Named host mounts are deployment owned; see M7 production instructions.
MOUNTED_ROOTS={}
CONNECTOR_NETWORK_ALLOWLIST=[]
CONNECTOR_ALLOW_PLAINTEXT_TEST=false
