# Copy to .env.production (ignored), supply independent random values, protect mode/ACL.
BOAH_DOMAIN=boah.example.com
POSTGRES_USER=boah
POSTGRES_DB=boah
POSTGRES_PASSWORD=
BOAH_MASTER_KEY_PATH=/secure/boah/master-key.secret
BOAH_INCOMING_PATH=/srv/boah/incoming
BOAH_ARCHIVE_PATH=/srv/boah/archive
BOAH_INITIAL_ADMIN_EMAIL=admin@example.com
BOAH_INITIAL_ADMIN_PASSWORD=
BOAH_SERVICE_TOKEN=
# Optional deployment-only exact host/CIDR exceptions for company LAN connectors:
CONNECTOR_NETWORK_ALLOWLIST=[]
